    <CheatEntry>
      <ID>64</ID>
      <Description>"Infinite Arrows"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(hhawahawa,Onimusha2.exe,44 0F BE 79 1C 48 8B 87 C8 02 00 00 48 85 C0)
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  mov [rcx+1C], #10

code:
  movsx r15d,byte ptr [rcx+1C]
  mov rax,[rdi+000002C8]
  test rax,rax
  jmp return

hhawahawa:
  jmp far newmem
  nop
return:
registersymbol(hhawahawa)

[DISABLE]

hhawahawa:
  db 44 0F BE 79 1C 48 8B 87 C8 02 00 00 48 85 C0

unregistersymbol(hhawahawa)
dealloc(newmem)
</AssemblerScript>
    </CheatEntry>
